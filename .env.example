# Copy this file to .env.local for local development, or set these as
# environment variables in Hostinger's Node.js app settings for production.
# All variables are optional — the contact form falls back to logging the
# lead server-side if neither delivery method below is configured.

# Where contact form leads are sent. Defaults to the address in src/config/site.ts.
CONTACT_RECIPIENT_EMAIL=hr@brothersolutions.online

# Option 1: Resend (tried first if set)
RESEND_API_KEY=

# Option 2: SMTP via Nodemailer (used if Resend is not configured or fails)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Google Search Console: HTML tag verification method.
# From Search Console > Settings > Ownership verification > HTML tag,
# copy only the "content" value (not the whole <meta> tag) into this var.
GOOGLE_SITE_VERIFICATION=
